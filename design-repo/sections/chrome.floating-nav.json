{
  "id": "chrome.floating-nav",
  "kind": "section",
  "contractVersion": "1.0.0",
  "category": "chrome",
  "pageOrder": 1,
  "purpose": "Fixed floating nav: logo home link, three in-page anchors and the 'Join waitlist' CTA that jumps to the hero form. Shrinks to a ringed pill once the page scrolls.",
