  "contentSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "logo",
      "links",
      "cta"
    ],
    "properties": {
      "logo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "srLabel",
          "ariaLabel"
        ],
        "properties": {
          "assetRole": {
            "enum": [
              "brand.logo-mark",
              "brand.placeholder-mark"
            ]
          },
          "srLabel": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 2,
            "x-realMaxWords": 1
          },
          "ariaLabel": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3,
            "x-realMaxWords": 2
          }
        }
      },
      "links": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "anchor"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 2,
              "x-realMaxWords": 1
            },
            "anchor": {
              "enum": [
                "#finding",
                "#saving",
                "#faq"
              ]
            }
          }
        }
      },
      "cta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3,
            "x-realMaxWords": 2
          },
          "href": {
            "const": "#waitlist"
          }
        }
      }
    }
  },
  "motionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "pattern",
      "secondary",
      "reducedMotionFallback"
    ],
    "properties": {
